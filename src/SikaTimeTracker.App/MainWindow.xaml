<Window
    x:Class="SikaTimeTracker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <SolidColorBrush x:Key="TrackingActiveBrush" Color="#2EA043" />
            <SolidColorBrush x:Key="TrackingAfkBrush" Color="#D13438" />
            <SolidColorBrush x:Key="TrackingInactiveBrush" Color="#8A8886" />
            <SolidColorBrush x:Key="TrackingReadyBrush" Color="#0078D4" />
        </Grid.Resources>
        <NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="True"
            PaneDisplayMode="Left"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.Resources>
                <!-- 指示条透明：消除选中指示条滑动动画（其 offset 动画在快速切换时会被打断） -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="活动" Icon="Calendar" Tag="activity" />
                <NavigationViewItem Content="分类规则" Icon="Bullets" Tag="rules" />
                <NavigationViewItem Content="设置" Icon="Setting" Tag="settings" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel
                    x:Name="TrackingStatusPanel"
                    Margin="8,12"
                    Spacing="4">
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="追踪状态" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="{StaticResource TrackingReadyBrush}" />
                        <TextBlock x:Name="StatusText" Text="正在启动" />
                    </StackPanel>
                    <StackPanel Margin="16,2,0,0" Spacing="2">
                        <TextBlock
                            x:Name="TrackedProcessText"
                            MaxWidth="190"
                            FontWeight="SemiBold"
                            Text="正在初始化"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="TrackedWindowText"
                            MaxWidth="190"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="TrackingDurationText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid x:Name="ContentHost" />
        </NavigationView>
        <!-- 自绘选中指示条层（Composition 动画控制位置，IsHitTestVisible=false 不挡交互） -->
        <Canvas
            x:Name="NavIndicatorLayer"
            IsHitTestVisible="False">
            <Border
                x:Name="NavIndicator"
                Width="3"
                Height="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="1.5"
                Opacity="0" />
        </Canvas>
    </Grid>
</Window>
