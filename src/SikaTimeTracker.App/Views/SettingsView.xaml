<UserControl
    x:Class="SikaTimeTracker.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,40" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="调整追踪、外观、数据与隐私选项" />
            </StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="启动与追踪" />
                    <ToggleSwitch Header="开机时自动启动" />
                    <ToggleSwitch Header="启动后最小化到系统托盘" />
                    <ToggleSwitch Header="启用空闲检测" IsOn="True" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="隐私" />
                    <ToggleSwitch Header="记录窗口标题" IsOn="True" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="所有数据仅存储在本机。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
