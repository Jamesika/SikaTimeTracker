<UserControl
    x:Class="SikaTimeTracker.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,40" Spacing="20">
                <Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="调整追踪、外观、数据与隐私选项" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Click="OnSaveClicked" Style="{StaticResource AccentButtonStyle}" Content="保存设置" />
                </Grid>

                <InfoBar x:Name="PageMessage" IsClosable="True" IsOpen="False" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="启动与后台" />
                        <ToggleSwitch x:Name="RunAtStartupToggle" Header="开机时自动启动" />
                        <ToggleSwitch x:Name="StartMinimizedToggle" Header="启动后直接在系统托盘运行" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="关闭主窗口后仍会在托盘继续追踪；从托盘菜单可退出应用。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="活动追踪" />
                        <ToggleSwitch x:Name="IdleDetectionToggle" Header="启用空闲检测" />
                        <NumberBox
                            x:Name="IdleMinutesBox"
                            Header="空闲阈值（分钟）"
                            Minimum="1"
                            Maximum="120"
                            SpinButtonPlacementMode="Inline" />
                        <NumberBox
                            x:Name="MinimumSecondsBox"
                            Header="最短记录时长（秒）"
                            Minimum="0"
                            Maximum="60"
                            SpinButtonPlacementMode="Inline" />
                        <NumberBox
                            x:Name="MergeGapSecondsBox"
                            Header="相邻同窗口记录合并间隔（秒）"
                            Minimum="0"
                            Maximum="300"
                            SpinButtonPlacementMode="Inline" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="外观与隐私" />
                        <ComboBox x:Name="ThemeBox" Header="主题" DisplayMemberPath="Name" />
                        <ToggleSwitch x:Name="RecordTitlesToggle" Header="记录窗口标题和网页域名" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="关闭后仅保存进程名称；更改会立即结束当前活动段并以新的隐私设置继续。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="数据" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="数据库位置" />
                        <TextBox x:Name="DatabasePathBox" IsReadOnly="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnOpenDataFolderClicked" Content="打开数据文件夹" />
                            <Button Click="OnExportClicked" Content="导出 CSV" />
                            <Button Click="OnClearDataClicked" Content="清空活动数据" />
                        </StackPanel>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CSV 默认导出到“文档\SikaTimeTracker”。清空活动不会删除分类、规则和设置。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <ProgressRing x:Name="BusyIndicator" Width="36" Height="36" IsActive="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
