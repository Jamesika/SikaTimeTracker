<UserControl
    x:Class="SikaTimeTracker.Views.ActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,24,32,40" Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="活动" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="回顾你的时间投入与每日节奏" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            x:Name="CategoryFilter"
                            Width="170"
                            Height="36"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            PlaceholderText="全部分类"
                            SelectionChanged="OnCategoryFilterChanged" />
                        <Button Height="36" MinWidth="40" VerticalAlignment="Center" Click="OnPreviousYearClicked" ToolTipService.ToolTip="上一年">
                            <FontIcon Glyph="&#xE76B;" />
                        </Button>
                        <Button x:Name="YearButton" Height="36" MinWidth="72" VerticalAlignment="Center" Click="OnCurrentYearClicked" />
                        <Button Height="36" MinWidth="40" VerticalAlignment="Center" Click="OnNextYearClicked" ToolTipService.ToolTip="下一年">
                            <FontIcon Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选中日期" />
                            <TextBlock x:Name="TodayTotalText" FontSize="28" FontWeight="SemiBold" Text="0 分钟" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="本周累计" />
                            <TextBlock x:Name="WeekTotalText" FontSize="28" FontWeight="SemiBold" Text="0 分钟" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="活跃日平均" />
                            <TextBlock x:Name="AverageTotalText" FontSize="28" FontWeight="SemiBold" Text="0 分钟" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="活动热力图" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5">
                                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="少" />
                                <Border Width="11" Height="11" Background="#1A8C959F" CornerRadius="2" />
                                <Border Width="11" Height="11" Background="#9BE9A8" CornerRadius="2" />
                                <Border Width="11" Height="11" Background="#40C463" CornerRadius="2" />
                                <Border Width="11" Height="11" Background="#30A14E" CornerRadius="2" />
                                <Border Width="11" Height="11" Background="#216E39" CornerRadius="2" />
                                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="多" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer
                            x:Name="HeatmapScrollViewer"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            SizeChanged="OnHeatmapViewportSizeChanged"
                            VerticalScrollMode="Disabled">
                            <StackPanel Spacing="6">
                                <Grid x:Name="MonthHeaderGrid" Height="22" HorizontalAlignment="Left" />
                                <Grid x:Name="HeatmapGrid" HorizontalAlignment="Left" />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="点击日期可在下方查看当天时间轴" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="TimelineTitleText" Style="{StaticResource SectionTitleStyle}" Text="今日时间轴" />
                                <TextBlock x:Name="TimelineSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Click="OnTodayClicked" Content="返回今天" />
                        </Grid>
                        <Grid MinHeight="166">
                            <ScrollViewer
                                x:Name="TimelineViewport"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                SizeChanged="OnTimelineViewportSizeChanged"
                                VerticalScrollMode="Disabled">
                                <Canvas x:Name="TimelineCanvas" Height="136" MinWidth="1152" />
                            </ScrollViewer>
                            <StackPanel x:Name="EmptyTimeline" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE823;" FontSize="28" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="这一天没有活动记录" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingIndicator" Width="36" Height="36" IsActive="False" />
    </Grid>
</UserControl>
