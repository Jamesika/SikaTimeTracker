<UserControl
    x:Class="SikaTimeTracker.Views.ActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,40" Spacing="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="活动" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="回顾你的时间投入与每日节奏" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="全部分类" />
                    <Button Content="今年" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="今日记录" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="0 小时" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="本周累计" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="0 小时" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="日均时长" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="0 小时" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="活动热力图" />
                    <Border Height="180" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE787;" FontSize="28" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="活动记录将显示在这里" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="今日时间轴" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选择热力图中的日期可查看当天详情" />
                    </StackPanel>
                    <Border Height="220" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="今天还没有活动记录" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
