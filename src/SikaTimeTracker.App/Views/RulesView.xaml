<UserControl
    x:Class="SikaTimeTracker.Views.RulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,24,32,40">
        <StackPanel Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="分类规则" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="按窗口标题或进程名称自动整理活动" />
            </StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE8FD;" FontSize="32" />
                    <TextBlock Text="尚未创建自定义规则" />
                    <Button HorizontalAlignment="Center" Content="新建规则" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
