<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SikaTimeTracker</RootNamespace>
    <AssemblyName>SikaTimeTracker</AssemblyName>
    <ApplicationIcon>Assets\SikaTimeTracker.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\SikaTimeTracker.ico" LogicalName="SikaTimeTracker.Assets.SikaTimeTracker.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SikaTimeTracker.Core\SikaTimeTracker.Core.csproj" />
    <ProjectReference Include="..\SikaTimeTracker.Infrastructure\SikaTimeTracker.Infrastructure.csproj" />
  </ItemGroup>

  <!-- The SDK's manifest cache does not include PublishSingleFile in its inputs.
       Regenerate it when switching between normal builds and single-file publish
       so WinUI DLLs resolve from the bundle extraction directory. -->
  <Target Name="RefreshWinUiRegistrationManifest"
          BeforeTargets="CreateWinRTRegistration"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true' and '$(SelfContainedIntermediateOutputPath)' != ''">
    <Delete Files="$(SelfContainedIntermediateOutputPath)Manifests\app.manifest" />
  </Target>
</Project>
